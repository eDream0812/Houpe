# ---------------------------------------------------------------------------
# Houpe — Git 忽略清单
#
# 原则：只提交"能完整还原工程"的源文件，
# 一切由本机生成、含机器路径或含凭据的东西都不入库。
# ---------------------------------------------------------------------------

# ---------- 本机配置（含 SDK 绝对路径 / 个人目录，绝不入库）----------
local.properties
.hvigor/
.cache/
.idea/
.vscode/
*.iml

# ---------- 签名凭据（口令与密钥库）----------
*.p12
*.cer
*.p7b
.cxx/

# ---------- 依赖（用 ohpm install 还原）----------
oh_modules/
.ohpm/
node_modules/

# ---------- 构建产物 ----------
build/
entry/build/
*/build/
*.hap
*.app
*.hsp
*.har
*.signed

# ---------- 系统与编辑器杂项 ----------
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
